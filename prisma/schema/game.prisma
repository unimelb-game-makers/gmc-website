model Game {
  id Int @id @default(autoincrement())
  name String
  thumbnail String?
  link String?
  description String?
  approved Boolean
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  tags GameTag[]
}

model Tag {
  id Int @id @default(autoincrement())
  name String 
  description String?

  games GameTag[]
}

model GameTag {
  gameId Int
  tagId  Int
  game   Game @relation(fields: [gameId], references: [id])
  tag    Tag  @relation(fields: [tagId], references: [id])

  @@id([gameId, tagId])
}


